# Debe coincidir con el ID creado en el panel web (Administración > Dispositivos)
DEVICE_ID=raspberry-pi-1

# Valores iniciales; luego se reemplazan por la configuración remota del panel
SAMPLE_INTERVAL_SECONDS=5
DISTANCIA_LIBRE_CM=23

# Frecuencia con que se consulta la configuración remota (segundos)
DEVICE_CONFIG_POLL_SECONDS=60

# URL pública de la plataforma en Vercel
API_BASE_URL=https://solemne-1-ti.vercel.app

# Carpeta con api-token.txt y vercel-bypass.txt (fuera del repositorio)
SECRETS_DIR=/home/matiascatalan/.config/estacionamiento

# Sensor IR de obstáculos: nivel de salida cuando detecta (0 o 1) y resistencia interna
IR_ACTIVE_LEVEL=0
IR_PULL=none
IR_DEBOUNCE_SECONDS=0.15
# Segundos entre un evento IR y el cambio a OCUPADO para contarlo como ingreso confirmado
VENTANA_INGRESO_SEGUNDOS=60
