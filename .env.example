# Variables de entorno de Vercel (Settings > Environment Variables).
# Para `vercel dev`, cópialas a .env.local (ignorado por git).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"estacionamiento-intelige-f3038"}
FIREBASE_PROJECT_ID=estacionamiento-intelige-f3038
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
FIREBASE_WEB_APP_ID=replace-with-firebase-web-app-id

# Solo para crear la primera organización; eliminar después
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ORGANIZATION_ID=organizacion-inicial
BOOTSTRAP_ORGANIZATION_NAME=Organizacion inicial

# Opcional (legado): token global que solo escribe en la demo pública.
# Déjalo sin definir cuando la Raspberry use su token de dispositivo.
API_TOKEN=
